  "tokenColors": [
    {
      "name": "注释：灰紫斜体，像小声说悄悄话",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#9C8FA6", "fontStyle": "italic" }
    },
    {
      "name": "关键字：莓红",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new"],
      "settings": { "foreground": "#C2185B" }
    },
    {
      "name": "运算符与分隔符：樱粉",
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"],
      "settings": { "foreground": "#D14C87" }
    },
    {
      "name": "字符串：抹茶绿",
      "scope": ["string", "string.quoted", "punctuation.definition.string", "string.regexp"],
      "settings": { "foreground": "#2F7A5F" }
    },
    {
      "name": "转义字符与占位符：深抹茶",
      "scope": ["constant.character.escape", "constant.other.placeholder", "string constant.other.placeholder"],
      "settings": { "foreground": "#1F6B4F", "fontStyle": "bold" }
    },
    {
      "name": "函数与调用：雾蓝",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#1F6F8B" }
    },
    {
      "name": "类型、类、接口：紫罗兰",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.class", "support.type", "storage.type.java", "storage.type.ts"],
      "settings": { "foreground": "#6D46D8" }
    },
    {
      "name": "数字与常量：焦糖",
      "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"],
      "settings": { "foreground": "#A15C00" }
    },
    {
      "name": "变量与属性：可可",
      "scope": ["variable", "variable.other", "variable.other.property", "variable.object.property", "meta.object-literal.key"],
      "settings": { "foreground": "#4A3B4F" }
    },
    {
      "name": "参数：奶咖粉",
      "scope": ["variable.parameter", "meta.function.parameters"],
      "settings": { "foreground": "#8A4A6B" }
    },
    {
      "name": "标签与属性名：莓红",
      "scope": ["entity.name.tag", "meta.tag", "entity.other.attribute-name"],
      "settings": { "foreground": "#C2185B" }
    },
    {
      "name": "Markdown 标题：莓红加粗",
      "scope": ["markup.heading", "markup.heading entity.name", "punctuation.definition.heading.markdown"],
      "settings": { "foreground": "#C2185B", "fontStyle": "bold" }
    },
    {
      "name": "Markdown 粗体 / 斜体 / 链接",
      "scope": ["markup.bold", "markup.italic", "markup.underline.link"],
      "settings": { "foreground": "#E8639E", "fontStyle": "bold" }
    },
    {
      "name": "Markdown 代码块：抹茶",
      "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw"],
      "settings": { "foreground": "#2F7A5F" }
    },
    {
      "name": "Markdown 引用：灰紫斜体",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#8C7C93", "fontStyle": "italic" }
    },
    {
      "name": "列表与任务标记：焦糖",
      "scope": ["punctuation.definition.list.begin.markdown", "markup.list.numbered", "markup.list.unnumbered"],
      "settings": { "foreground": "#A15C00" }
    },
    {
      "name": "JSON / YAML 的键：雾蓝",
      "scope": ["support.type.property-name.json", "entity.name.tag.yaml", "punctuation.definition.key-value.yaml"],
      "settings": { "foreground": "#1F6F8B" }
    },
    {
      "name": "CSS 选择器与属性",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "support.type.property-name.css", "entity.name.tag.css"],
      "settings": { "foreground": "#D14C87" }
    },
    {
      "name": "特殊变量",
      "scope": ["variable.language", "variable.language.this", "variable.language.super", "variable.language.self"],
      "settings": { "foreground": "#C2185B", "fontStyle": "italic" }
    },
    {
      "name": "被弃用 / 无效",
      "scope": ["invalid", "invalid.deprecated"],
      "settings": { "foreground": "#D6336C", "fontStyle": "strikethrough" }
    },
    {
      "name": "Python 装饰器与异常",
      "scope": ["entity.name.function.decorator", "meta.function.decorator", "support.type.exception.python"],
      "settings": { "foreground": "#6D46D8" }
    },
    {
      "name": "C / C++ 预处理指令",
      "scope": ["meta.preprocessor", "keyword.control.import", "keyword.control.directive"],
      "settings": { "foreground": "#6D46D8", "fontStyle": "italic" }
    },
    {
      "name": "Diff 增删",
      "scope": ["markup.inserted", "markup.deleted", "markup.changed"],
      "settings": { "foreground": "#2F7A5F" }
    }
  ]
}
